{#
 * @copyright 2026 City of Bloomington, Indiana
 * @license http://www.gnu.org/licenses/agpl.txt GNU/AGPL, see LICENSE
 * @param array  service             Open311 Service information array
 * @param array  attributes          Open311 definition of custom fields
 * @param string group_code
 * @param string google_maps_api_key
 * @param string recaptcha_site_key
 * @param float  default_latitude
 * @param float  default_longitude
 * @param string first_name
 * @param string last_name
 * @param string email
 * @param string phone
 *
 * Post Fields
 * @param string address_string
 * @param float  lat
 * @param float  long
 * @param string description
 *
 * @param string accept     Comma separated mime_types that are accepted
 * @param int    maxBytes   Max upload size in bytes
 * @param string maxSize    Max upload size, human readable
#}
{% extends "html/layouts/default.twig" %}
{% import  "html/macros/forms.twig" as forms %}
{% block content %}
<section>
    <header>
         <h1>{{ service.group }}</h1>
        <nav           class="usa-step-indicator usa-step-indicator--counters-sm">
            <ol        class="usa-step-indicator__segments">
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--complete">
                    <a class="usa-step-indicator__segment-label" href="{{ uri('home.index') }}">
                        Group <span class="usa-sr-only">completed</span>
                    </a>
                </li>
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--complete">
                    <a class="usa-step-indicator__segment-label" href="{{ uri('home.service', { group_code:group_code }) }}">
                        Service <span class="usa-sr-only">completed</span>
                    </a>
                </li>
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--complete">
                    <a class="usa-step-indicator__segment-label" href="{{ uri('home.contact', {'group_code':group_code, 'service_code':service.service_code}) }}">
                        Contact Info <span class="usa-sr-only">completed</span>
                    </a>
                </li>
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--current">
                    <a class="usa-step-indicator__segment-label">
                        Request Details
                    </a>
                </li>
            </ul>
        </nav>
    </header>
    <h2>{{ service.service_name }}</h2>
    <form class="usa-form usa-form--large" method="post" enctype="multipart/form-data" id="service_request_form">
        <fieldset class="usa-fieldset">
            <legend class="usa-legend--large">Service request location:</legend>
            <div id="map_container">
                <div id="map"></div>
                <img src="{{ BASE_URI }}/css/img/crosshairs.svg" />
            </div>

            <h3>Address:</h3>
            <div class="usa-search usa-search--small">
                <label  for="address_string" class="usa-sr-only">Search</label>
                <input name="address_string" class="usa-input" type="search"
                         id="address_string" />
                <button class="usa-button" type="submit">
                    <img src="{{ USWDS_URL }}/img/usa-icons-bg/search--white.svg" class="usa-search__submit-icon" alt="Search" />
                </button>
                <input name="lat"  id="lat"  type="hidden" value="{{ lat  }}" />
                <input name="long" id="long" type="hidden" value="{{ long }}" />
            </div>
        </fieldset>

        <fieldset class="usa-fieldset">
            <legend class="usa-legend--large">General information:</legend>
            {{ forms.field_textarea('description', 'description', 'Describe the issue:', description, true) }}
            {{ forms.field_file('media', 'media', 'Include Image', null,
                                accept, maxSize, maxBytes, false, {},
                                accept ~ ' - ' ~ maxSize) }}
        </fieldset>

        {% if attributes %}
        <fieldset class="usa-fieldset">
            <legend class="usa-legend--large">{{ service.service_name }} information:</legend>
            {% for a in attributes %}
            <div>
                {% if a.datatype=="string" %}
                {{ forms.field_text(a.code, a.code, a.description, null, a.required) }}
                {% elseif a.datatype=="text" %}
                {{ forms.field_textarea(a.code, a.code, a.description, null, a.required) }}
                {% elseif a.datatype=="number" %}
                {{ forms.field_number(a.code, a.code, a.description, null, a.required) }}
                {% elseif a.datatype=="datetime" %}
                {{ forms.field_datetime(a.code, a.code, a.description, null, a.required) }}
                {% else %}
                <label class="usa-label" for="{{ a.code }}">{{ a.description }}{{ a.required ? ' <span>*</span>' : '' }}</label>
                <select id="{{ a.code }}" name="{{ a.code }}" class="usa-select"
                        {{- a.required ? ' required="true"' : '' }}
                        {{- a.datatype=="multivaluelist" ? ' multiple="true"' : '' }}>
                    {{ a.datatype=='singlevaluelist' ? '<option value="">--Please choose an option--</option>' : '' }}
                    {% for f in a.values %}
                    <option value="{{ f.key }}">{{ f.name }}</option>
                    {% endfor %}
                </select>
                {% endif %}
            </div>
            {% endfor %}
        </fieldset>
        {% endif %}

        <input type="hidden" name="first_name"   value="{{ first_name }}" />
        <input type="hidden" name="last_name"    value="{{ last_name  }}" />
        <input type="hidden" name="phone"        value="{{ phone      }}" />
        <input type="hidden" name="email"        value="{{ email      }}" />
        <input type="hidden" name="service_code" value="{{ service.service_code }}" />
        <button type="submit" class="usa-button g-recaptcha"
            data-sitekey="{{ recaptcha_site_key }}"
            data-callback='recaptcha'
            data-action='submit'>
            Submit
        </button>

    </form>
</section>
<script src="https://www.google.com/recaptcha/api.js"></script>
<script>
    const DEFAULT_LATITUDE  = {{ default_latitude }},
          DEFAULT_LONGITUDE = {{ default_longitude }};

    function recaptcha(token) { document.getElementById('service_request_form').submit(); }
</script>
<script async src="https://maps.googleapis.com/maps/api/js?libraries=maps,places&key={{ google_maps_api_key }}&loading=async&v=weekly&callback=initMap"></script>
<script src="{{ BASE_URI }}/js/map-{{ VERSION }}.js"></script>
<script src="{{ BASE_URI }}/js/form-{{ VERSION }}.js"></script>
{% endblock %}
