{% extends "html/layouts/default.twig" %}
{% import  "html/macros/forms.twig" as forms %}
{% block content %}
<section>
    <header>
        <h1>{{ service.group }}</h1>
        <nav           class="usa-step-indicator usa-step-indicator--counters-sm">
            <ol        class="usa-step-indicator__segments">
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--complete">
                    <a class="usa-step-indicator__segment-label" href="{{ uri('home.index') }}">
                        Group <span class="usa-sr-only">completed</span>
                    </a>
                </li>
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--complete">
                    <a class="usa-step-indicator__segment-label" href="{{ uri('home.service', { group_code:group_code }) }}">
                        Service <span class="usa-sr-only">completed</span>
                    </a>
                </li>
                <li    class="usa-step-indicator__segment usa-step-indicator__segment--current">
                    <a class="usa-step-indicator__segment-label">
                        Contact Info
                    </a>
                </li>
                <li    class="usa-step-indicator__segment">
                    <a class="usa-step-indicator__segment-label">
                        Request Details <span class="usa-sr-only">not completed</span>
                    </a>
                </li>
            </ul>
        </nav>
    </header>
    <h2>{{ service.service_name }}</h2>
    <p>{{ service.description  }}</p>
    <form class="usa-form usa-form--large" method="post">
        <fieldset class="usa-fieldset">
            <legend class="usa-legend">Your Information</legend>
            <p>Note: <i>Information you provide through uReport is stored and retained by the City as a public record.</i></p>
            {{ forms.field_text('first_name', 'first_name', 'First Name:', null, true )}}
            {{ forms.field_text('last_name',  'last_name',  'Last Name:' , null, true )}}
            {{ forms.field_text('phone',      'phone',      'Phone:'     , null, true )}}
            {{ forms.field_text('email',      'email',      'Email:'     , null, true )}}

            {{ forms.button('submit', 'Next', 'submit') }}
        </fieldset>
    </form>
</section>
<script>
function saveInput(event) {
    let input = event.target;
    localStorage.setItem(input.getAttribute('id'), input.value);
}
for (const f of ['first_name', 'last_name', 'email', 'phone']) {
    let i = document.getElementById(f);

    i.value = localStorage.getItem(f);
    i.addEventListener('change', saveInput);
}
</script>

{% endblock %}
