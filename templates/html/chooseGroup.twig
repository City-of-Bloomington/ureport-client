{% extends "html/layouts/default.twig" %}

{% block content %}
<section>
    <header>
        <h1>Report an Issue</h1>
        <div class="usa-alert usa-alert--info">
            <div class="usa-alert__body">
                <h2 class="usa-alert__heading">Non-Emergency Use Only:</h2>
                <p>This system is not for reporting emergencies or imminent safety hazards. If this is an emergency, please dial 9-1-1.</p>
            </div>
        </div>
        <div class="usa-alert usa-alert--info">
            <div class="usa-alert__body">
                <h2 class="usa-alert__heading">Public Record:</h2>
                <p>Information you provide through uReport is stored and retained by the City as a public record.</p>
            </div>
        </div>
    </header>

    <p>Type to search for services or a ticket</p>
    <form class="usa-search" role="search">
        <label  for="query" class="usa-sr-only">Search</label>
        <input name="query" class="usa-input" type="search"
                    id="query" value="{{ query }}" placeholder="Example: Removal or #000000" />
        <button class="usa-button" type="submit">
            <span class="usa-search__submit-text">Search</span>
            <img  class="usa-search__submit-icon" alt="search"
                    src="{{ USWDS_URL }}/assets/img/usa-icons-bg/search--white.svg" />
        </button>
    </form>
    <div id="searchResults">
        {% if searchResults %}{{ include('html/partials/searchResults.twig') }}{% endif %}
    </div>

    <h2>Select a Service Type</h2>
    <div class="usa-accordion">
        {% for code, group in groups %}
        <h3 class="usa-accordion__heading">
            <button class="usa-accordion__button" type="button" aria-controls="{{ code }}">{{ group.name }}</button>
        </h3>
        <div class="usa-accordion__content" id="{{ code }}">
            <ul class="usa-card-group">
                {% for s in group.services %}
                <li class="usa-card grid-col-12">
                    <div class="usa-card__container">
                        <div class="usa-card__header">
                            <h4 class="usa-card__heading">{{ s.service_name }}</h4>
                        </div>
                        <div class="usa-card__body">
                            <p>{{ s.description }}</p>
                        </div>
                        <div class="usa-card__footer">
                            <a class="usa-button" href="{{ uri('home.contact', {'service_code':s.service_code, 'group_code':code}) }}">
                                Request
                            </a>
                        </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>

        {% endfor %}
    </div>
</section>
<script src="{{ BASE_URI }}/js/search-{{ VERSION }}.js"></script>
{% endblock %}
