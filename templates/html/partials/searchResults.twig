<ul class="usa-card-group">

{% for s in searchResults %}
{% if s.service_request_id is defined %}
    <li class="usa-card grid-col-12">
        <div class="usa-card__container">
            <div class="usa-card__header">
                <h4 class="usa-card__heading">{{ s.service_name }}</h4>
            </div>
            <div class="usa-card__body">
                <p>{{ s.status }} {{ s.requested_datetime | date('m/d/Y') }} {{ s.agency_responsible }}</p>
                <p>{{ s.description }}</p>
            </div>
            <div class="usa-card__footer">
                <a class="usa-button" href="https://bloomington.in.gov/crm/tickets/view?ticket_id={{ s.service_request_id }}">
                    View Ticket
                </a>
            </div>
        </div>
    </li>
{% else %}
    <li class="usa-card grid-col-12">
        <div class="usa-card__container">
            <div class="usa-card__header">
                <h4 class="usa-card__heading">{{ s.service_name }}</h4>
            </div>
            <div class="usa-card__body">
                <p>{{ s.description }}</p>
            </div>
            <div class="usa-card__footer">
                <a class="usa-button" href="{{ uri('home.contact', {'service_code':s.service_code, 'group_code':s.group_code}) }}">
                    Request
                </a>
            </div>
        </div>
    </li>
{% endif %}
{% endfor %}
</ul>
